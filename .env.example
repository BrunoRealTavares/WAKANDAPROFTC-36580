# ============================================================
# WAKANDA PRO 36580 — Variáveis de ambiente (cópia: .env.local)
# ============================================================
# Nunca commite este arquivo com valores reais. Use .env.example
# como referência e crie .env.local com seus próprios segredos.

# ---- Banco de dados (SQLite via libsql / Drizzle) ----
# Caminho absoluto ou relativo ao arquivo .db. Em desenvolvimento usa
# o arquivo local em data/production.db (gitignorado).
WP_DB_URL="file:./data/production.db"

# ---- Segredo de sessão do painel (HMAC-SHA256 do cookie wp_session) ----
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WP_SESSION_SECRET="coloque_aqui_um_secreto_de_no_minimo_32_bytes_hex"

# ---- URL pública do site (para sitemap, robots, e-mails) ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Uploads (apenas imagem e PDF, limite de tamanho) ----
WP_UPLOAD_MAX_MB="5"

# ============================================================
# Exemplo de preenchimento (não commite valores reais):
# WP_DB_URL="file:./data/production.db"
# WP_SESSION_SECRET="a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2"
# NEXT_PUBLIC_SITE_URL="https://wakandaproftc36580.vercel.app"
# WP_UPLOAD_MAX_MB="5"
# ============================================================
